# ---------------------------------------------------------------
# Landing pública (van al navegador del doctor; el prefijo VITE_ las
# hornea en el bundle, así que aquí SOLO valores publicables).
# Si no se definen, se usan los de src/config.js.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
VITE_SUPABASE_TABLE=leads_congreso_lab

# ---------------------------------------------------------------
# Dashboard /leads — SOLO servidor, las usa api/leads.js.
# NUNCA les pongas el prefijo VITE_: eso las publicaría en el
# navegador y expondría toda la tabla de doctores.
# En Vercel se cargan en Settings -> Environment Variables.
# ---------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
DASHBOARD_PASSWORD=la-clave-del-equipo
